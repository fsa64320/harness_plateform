# Copier vers deploy/.env et remplacer chaque valeur. Ne jamais commiter deploy/.env.
# Propriétaire de la base (migrations) et rôle applicatif « harness_app » (sans BYPASSRLS) : deux mots de passe.
# Les URL de connexion sont composées par docker-compose.yml.
POSTGRES_PASSWORD=
HARNESS_APP_PASSWORD=
# Clé AES-256 en base64 (32 octets) : python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
HARNESS_ENCRYPTION_KEY=
OIDC_ISSUER=http://dex:5556/dex
OIDC_CLIENT_ID=harness
OIDC_CLIENT_SECRET=
OLLAMA_BASE_URL=http://ollama:11434
LANGSMITH_TRACING=false
# Développement local en http : le cookie de session ne peut pas être « Secure ». Laisser true en production.
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:5173
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
# Autorise des serveurs MCP et des webhooks sur des adresses privées (politique réseau : voir README).
HARNESS_ALLOW_PRIVATE_NETWORKS=false
